SITE_URL=https://stillmeditation.app/
SITEMAP_URL=https://stillmeditation.app/sitemap.xml
GSC_SITE_URL=sc-domain:stillmeditation.app

# Google service account JSON downloaded from Google Cloud.
# Add the service account email as an owner/user in Search Console and GA4.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/google-service-account.json

# Alternative to a service account when a product UI will not accept service account emails.
# First run scoped ADC login, then uncomment this:
# GOOGLE_ACCESS_TOKEN_COMMAND=gcloud auth application-default print-access-token

# GA4 property id, numeric only.
GA4_PROPERTY_ID=

# Optional GA4 setup targets. Existing GA4 account id is required to create a property.
GA4_ACCOUNT_ID=
GA4_WEB_STREAM_URL=https://stillmeditation.app/
GA4_WEB_STREAM_NAME=Still website

# App Store Connect API key values.
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_PRIVATE_KEY_PATH=/absolute/path/AuthKey_XXXXXXXXXX.p8
APP_STORE_BUNDLE_ID=
